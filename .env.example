# Copy this file to .env and add your own newly rotated OpenAQ API key.
# Do not put real credentials in this file.
OPENAQ_API_KEY= f1bacf09a95f2f45923d81c20d94aa37fd52f86409121fd1b71948aadbde0a6a

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AIR_QUALITY_TOPIC=airsense.air-quality.raw
KAFKA_WEATHER_TOPIC=airsense.weather.raw

# Ingestion configuration
REQUEST_TIMEOUT_SECONDS=30
OPENAQ_RADIUS_METERS=25000
OPENAQ_PAGE_LIMIT=100
OPENAQ_MAX_LOCATIONS=30
OPENAQ_REQUEST_DELAY_SECONDS=0.2
